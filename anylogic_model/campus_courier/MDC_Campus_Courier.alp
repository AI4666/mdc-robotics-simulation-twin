		<CompareRunsExperiment ActiveObjectClassId="1762800000435">
			<Id>1795478206704</Id>
			<Name><![CDATA[CompareRuns_Policies]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>2048</MaximumMemory>
			<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[root.appendRow("exp_compare_runs.csv");
policyToRun = (policyToRun + 1) % 3;   // next Run uses the next policy
crKmDS.add(root.dispatchPolicy, root.totalRobotKm());
crHoursDS.add(root.dispatchPolicy, root.avgHoursToLocker());
crCostDS.add(root.dispatchPolicy, root.monthlyCost());
crSameDayDS.add(root.dispatchPolicy, root.sameDayPctAll());]]></AfterSimulationRunCode>
