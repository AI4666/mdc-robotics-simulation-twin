					<TextCode><![CDATA["TODAY  arrived " + dayArrived + "   delivered to lockers " + dayDelivered + "   late drops " + dayLateDrops + "\nSame-day delivery today: " + f1(sameDayPctToday()) + " %     all days: " + f1(sameDayPctAll()) + " %\nAvg hours from vendor drop to locker: " + f1(avgHoursToLocker()) + "\nMailroom: waiting to sort " + notYetSorting + ", sorting " + inSorting + ", sorted for robots " + sortedWaiting() + "  (" + f1(sortedWaitingUnits()) + " robot slots)\nClerks busy: " + mailClerks.busy() + " / " + numberOfClerks + "   robots busy: " + busyRovers() + " / " + rovers.size() + "   students walking: " + activeWalkers() + "\nAvg battery: " + f1(avgBattery()) + " %   charging " + padsBusy + "/" + numberOfChargingPads + " pads, queue " + chargeQueue.size() + "\nLocker-full events: " + lockerFullEvents + "   robot km today: " + f1(dayDistanceM / 1000.0) + (dispatchPolicy == 2 ? "\nQ-learning: epsilon " + f1(qEpsilon < 0 ? rlEpsilonStart : qEpsilon) + "   reward today " + f1(qDayReward) : "")]]></TextCode>
					<Font>
						<Name>SansSerif</Name>
						<Size>12</Size>
						<Style>0</Style>
					</Font>
					<Alignment>LEFT</Alignment>
				</Text>
