		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1762800000435">
			<Id>1795478206708</Id>
			<Name><![CDATA[Sensitivity_AmazonVolume]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>2048</MaximumMemory>
			<RandomNumberGenerationType>randomSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<BeforeEachExperimentRunCode><![CDATA[new java.io.File("output", "exp_sensitivity.csv").delete();   // fresh results file for this experiment
snHoursDS.reset(); snKmDS.reset(); snCostDS.reset(); snSameDayDS.reset();]]></BeforeEachExperimentRunCode>
			<AfterSimulationRunCode><![CDATA[root.appendRow("exp_sensitivity.csv");
double a = root.amazonPackagesPerDay;
snHoursDS.add(a, root.avgHoursToLocker());
snKmDS.add(a, root.totalRobotKm());
snCostDS.add(a, root.monthlyCost());
snSameDayDS.add(a, root.sameDayPctAll());]]></AfterSimulationRunCode>
			<SeedValue>1</SeedValue>
			<SelectionModeForSimultaneousEvents>LIFO</SelectionModeForSimultaneousEvents>
