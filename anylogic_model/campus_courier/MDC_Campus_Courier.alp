		<!--   =========  Optimization Experiment   ========  -->
		<OptimizationExperiment ActiveObjectClassId="1762800000435">
			<Id>1795478206701</Id>
			<Name><![CDATA[Optimization_FleetSize]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>2048</MaximumMemory>
			<RandomNumberGenerationType>randomSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<BeforeEachExperimentRunCode><![CDATA[new java.io.File("output", "exp_optimization.csv").delete();   // fresh results file for this experiment
optRun = 0; bestCost = Double.MAX_VALUE; bestText = "no solution with >= 95% same-day yet";
optCostDS.reset(); optBestDS.reset(); optRobotsDS.reset(); optSameDayDS.reset();]]></BeforeEachExperimentRunCode>
			<AfterSimulationRunCode><![CDATA[root.appendRow("exp_optimization.csv");
optRun++;
double c = root.monthlyCost();
optCostDS.add(optRun, c);
optSameDayDS.add(optRun, root.sameDayPctAll());
optRobotsDS.add(root.numberOfRovers, c);
if (root.sameDayPctAll() >= 95 && c < bestCost) {
    bestCost = c;
    bestText = root.numberOfRovers + " robots, " + root.numberOfChargingPads + " pads, leave at " + root.f1(root.batchFillPct)
             + "% full  ->  $" + root.f1(c) + " for " + root.workDays + " days, same-day " + root.f1(root.sameDayPctAll()) + "%";
}
if (bestCost < Double.MAX_VALUE) optBestDS.add(optRun, bestCost);]]></AfterSimulationRunCode>
			<SeedValue>1</SeedValue>
			<SelectionModeForSimultaneousEvents>LIFO</SelectionModeForSimultaneousEvents>
			<VmArgs><![CDATA[]]></VmArgs>
			<LoadRootFromSnapshot>false</LoadRootFromSnapshot>
