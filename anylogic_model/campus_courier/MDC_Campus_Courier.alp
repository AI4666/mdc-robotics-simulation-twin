		</OptimizationExperiment>
		<!--   =========  Optimization Experiment   ========  -->
		<OptimizationExperiment ActiveObjectClassId="1762800000435">
			<Id>1795478206710</Id>
			<Name><![CDATA[Calibration_TravelTime]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>2048</MaximumMemory>
			<RandomNumberGenerationType>randomSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<BeforeEachExperimentRunCode><![CDATA[new java.io.File("output", "exp_calibration.csv").delete();   // fresh results file for this experiment
calRun = 0; bestErr = Double.MAX_VALUE; bestCalText = "-";
calErrDS.reset(); calBestDS.reset(); calQuietDS.reset(); calRushDS.reset(); calObsQuietDS.reset(); calObsRushDS.reset();]]></BeforeEachExperimentRunCode>
			<AfterSimulationRunCode><![CDATA[root.appendRow("exp_calibration.csv");
calRun++;
double e = root.calibrationError();
calErrDS.add(calRun, e);
if (e < bestErr) {
    bestErr = e;
    bestCalText = "map scale " + root.f1(root.metersPerTwinUnit) + " m/unit, crowd impact " + String.format(java.util.Locale.US, "%.3f", root.crowdImpactPerWalker)
                + "  ->  quiet " + root.f1(root.simTripQuietMin()) + " min (target " + root.f1(root.obsTripQuietMin) + "), class change "
                + root.f1(root.simTripRushMin()) + " min (target " + root.f1(root.obsTripRushMin) + ")";
}
calBestDS.add(calRun, bestErr);
calQuietDS.add(calRun, root.simTripQuietMin());
calRushDS.add(calRun, root.simTripRushMin());
calObsQuietDS.add(calRun, root.obsTripQuietMin);
calObsRushDS.add(calRun, root.obsTripRushMin);]]></AfterSimulationRunCode>
			<SeedValue>1</SeedValue>
			<SelectionModeForSimultaneousEvents>LIFO</SelectionModeForSimultaneousEvents>
