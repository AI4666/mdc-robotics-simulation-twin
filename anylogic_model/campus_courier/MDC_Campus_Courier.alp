		<ParamVariationExperiment ActiveObjectClassId="1762800000435">
			<Id>1795478206706</Id>
			<Name><![CDATA[MonteCarlo_Month]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>2048</MaximumMemory>
			<RandomNumberGenerationType>randomSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<BeforeEachExperimentRunCode><![CDATA[new java.io.File("output", "exp_monte_carlo.csv").delete();   // fresh results file for this experiment
mcRuns = 0; mcSameDayH.reset(); mcHoursH.reset(); mcKmH.reset(); mcCostH.reset();]]></BeforeEachExperimentRunCode>
			<AfterSimulationRunCode><![CDATA[root.appendRow("exp_monte_carlo.csv");
mcRuns++;
mcSameDayH.add(root.sameDayPctAll());
mcHoursH.add(root.avgHoursToLocker());
mcKmH.add(root.totalRobotKm());
mcCostH.add(root.monthlyCost());]]></AfterSimulationRunCode>
