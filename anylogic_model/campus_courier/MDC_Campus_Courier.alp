			<ObjectiveFunctionCode><![CDATA[root.monthlyCost()]]></ObjectiveFunctionCode>
			<Objective>MINIMIZE</Objective>  
			<OptimizationEngine>OPTQUEST</OptimizationEngine>
			<AllowParallelEvaluations>false</AllowParallelEvaluations>
			<Requirement>
				<Enabled>true</Enabled>
				<Expression><![CDATA[root.sameDayPctAll()]]></Expression>
				<Type>MORE_OR_EQUAL</Type>
				<Bound>95.0</Bound>
			</Requirement>
			<ReplicationsProperties>
				<UseReplication>false</UseReplication>
				<FixedReplicationsNumber>true</FixedReplicationsNumber>
				<ReplicationPerIteration>1</ReplicationPerIteration>
				<MinimumReplication>2</MinimumReplication>
				<MaximumReplication>2</MaximumReplication>
				<ConfidenceLevel>LEVEL_80</ConfidenceLevel>
				<ErrorPercent>0.5</ErrorPercent>
			</ReplicationsProperties>
